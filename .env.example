# Atlassian Jira Cloud REST API Configuration
# Base URL for your Jira Cloud instance
JIRA_BASE_URL=https://your-domain.atlassian.net

# Atlassian user account email
JIRA_EMAIL=your-email@example.com

# Atlassian API token (create at: https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_atlassian_api_token_here

# Comma-separated list of allowed Jira project keys (enforces principle of least privilege)
ALLOWED_PROJECTS=NOC
